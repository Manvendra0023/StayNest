<% layout("/layouts/boilerplate") %>

<div class="chat-page">
  <div class="chat-inbox-container">
    <div class="chat-header">
      <h3><i class="fa-solid fa-envelope text-danger"></i> Inbox</h3>
      <% if(unreadCount > 0) { %>
      <span class="badge bg-danger"><%= unreadCount %> unread</span>
      <% } %>
    </div>

    <% if(conversationUsers.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">💬</div>
      <h4>No conversations yet</h4>
      <p>Contact a host from any listing to start chatting!</p>
      <a href="/listings" class="btn btn-danger mt-2">Browse Listings</a>
    </div>
    <% } %>

    <div class="conversation-list">
      <% for(let user of conversationUsers) { %>
      <a href="/chat/<%= user._id %>" class="conversation-item">
        <div class="conv-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
        <div class="conv-info">
          <strong>@<%= user.username %></strong>
          <p class="text-muted mb-0 small">Click to view conversation</p>
        </div>
        <i class="fa-solid fa-chevron-right text-muted"></i>
      </a>
      <% } %>
    </div>
  </div>
</div>
