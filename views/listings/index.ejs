<% layout("/layouts/boilerplate") %>

<!-- FILTER PANEL -->
<div class="filter-panel-wrapper border-bottom">
  <!-- CATEGORY FILTER BAR -->
  <div class="filters-wrapper">
    <div class="category-bar">
      <a href="/listings" class="filter-link fixed-home">
        <div class="filter">
          <i class="fa-solid fa-house-user"></i>
          <p>All</p>
        </div>
      </a>
      <div id="filters" class="category-scroll">
        <% categories.forEach(cat => { %>
          <a
            href="/listings?category=<%= encodeURIComponent(cat.name) %><%= typeof filters !== 'undefined' && filters.search ? '&search=' + encodeURIComponent(filters.search) : '' %>"
            class="filter-link <%= activeCategory === cat.name ? 'active' : '' %>"
          >
            <div class="filter">
              <i class="fa-solid <%= cat.icon %>"></i>
              <p><%= cat.name %></p>
            </div>
          </a>
        <% }) %>
      </div>
    </div>
    <div class="tax-toggle">
      <div class="form-check-reverse form-switch">
        <input 
          class="form-check-input" 
          type="checkbox" 
          role="switch" 
          id="switchCheckDefault"
        />
        <label class="form-check-label" for="switchCheckDefault">Total after taxes</label>
      </div>
    </div>
  </div>

  <!-- ADVANCED FILTER ROW -->
  <div class="advanced-filters-row">
    <button class="btn btn-sm adv-filter-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#advFilters">
      <i class="fa-solid fa-sliders"></i> Filters
      <% 
        const hasFilters = (typeof filters !== 'undefined') && (filters.minPrice || filters.maxPrice || filters.guests || filters.sort);
      %>
      <% if(hasFilters) { %><span class="filter-active-dot"></span><% } %>
    </button>

    <div class="collapse" id="advFilters">
      <form action="/listings" method="GET" class="adv-filter-form">
        <% if(typeof filters !== 'undefined' && filters.category) { %>
          <input type="hidden" name="category" value="<%= filters.category %>">
        <% } %>
        <% if(typeof filters !== 'undefined' && filters.search) { %>
          <input type="hidden" name="search" value="<%= filters.search %>">
        <% } %>

        <div class="adv-filter-grid">
          <div class="adv-filter-group">
            <label>Min Price (₹)</label>
            <input type="number" name="minPrice" class="form-control form-control-sm" 
              placeholder="e.g. 1000"
              value="<%= typeof filters !== 'undefined' && filters.minPrice ? filters.minPrice : '' %>">
          </div>
          <div class="adv-filter-group">
            <label>Max Price (₹)</label>
            <input type="number" name="maxPrice" class="form-control form-control-sm" 
              placeholder="e.g. 10000"
              value="<%= typeof filters !== 'undefined' && filters.maxPrice ? filters.maxPrice : '' %>">
          </div>
          <div class="adv-filter-group">
            <label>Min Guests</label>
            <input type="number" name="guests" class="form-control form-control-sm" 
              placeholder="e.g. 2" min="1"
              value="<%= typeof filters !== 'undefined' && filters.guests ? filters.guests : '' %>">
          </div>
          <div class="adv-filter-group">
            <label>Sort By</label>
            <select name="sort" class="form-select form-select-sm">
              <option value="">Default</option>
              <option value="price_asc" <%= typeof filters !== 'undefined' && filters.sort === 'price_asc' ? 'selected' : '' %>>Price: Low to High</option>
              <option value="price_desc" <%= typeof filters !== 'undefined' && filters.sort === 'price_desc' ? 'selected' : '' %>>Price: High to Low</option>
              <option value="newest" <%= typeof filters !== 'undefined' && filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
            </select>
          </div>
          <div class="adv-filter-actions">
            <button type="submit" class="btn btn-danger btn-sm">Apply</button>
            <a href="/listings<%= activeCategory ? '?category=' + encodeURIComponent(activeCategory) : '' %>" class="btn btn-outline-secondary btn-sm">Reset</a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>


<!-- LISTINGS GRID -->
<div class="listings mt-3">
    <% for (let listing of allListings) { %>

        <div class="listing-item-wrapper">
          <!-- Favorite Button -->
          <% if(currUser) { %>
          <button 
            class="fav-btn" 
            data-listing-id="<%= listing._id %>"
            title="Add to Wishlist"
          >
            <i class="fa-heart <%= currUser && listing._id ? 'fa-regular' : 'fa-regular' %>"></i>
          </button>
          <% } %>

          <a href="/listings/<%= listing._id %>" class="listing-link">
              <div class="card listing-card">
                  <img 
                      src="<%= listing.image?.url || '/images/default.jpg' %>" 
                      class="card-img-top"
                      alt="<%= listing.title %>"
                      loading="lazy"
                  />
                  <div class="card-img-overlay"></div>

                  <div class="card-body">
                      <p class="card-text mb-1">
                          <strong><%= listing.title %></strong>
                      </p>
                      <p class="card-text mb-0 location-text">
                        <i class="fa-solid fa-location-dot text-danger"></i> <%= listing.location %>, <%= listing.country %>
                      </p>
                      <p class="mb-0 price-text">
                          &#8377; <%= listing.price.toLocaleString("en-IN") %> / night
                          <i class="tax-info"> &nbsp; &nbsp;+18% GST</i>
                      </p>
                  </div>
              </div>
          </a>
        </div>
    <% } %>
</div>


<% if (allListings.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">🏠</div>
    <h3>No stays found</h3>
    <p>Try adjusting your search filters or browse all listings</p>
    <a href="/listings" class="btn btn-danger mt-2">Browse All Stays</a>
  </div>
<% } %>


<!-- MAP VIEW (only show if listings have geocoordinates) -->
<% 
  const geoListings = allListings.filter(l => l.geometry && l.geometry.lat && l.geometry.lng);
%>
<% if(geoListings.length > 0) { %>
<div class="map-section mt-4 mb-4">
  <h5 class="map-title"><i class="fa-solid fa-map-location-dot text-danger"></i> Listings on Map</h5>
  <div id="listings-map" class="listings-map"></div>
</div>
<script>
  const mapListings = <%- JSON.stringify(geoListings.map(l => ({
    id: l._id,
    title: l.title,
    location: l.location,
    price: l.price,
    image: l.image ? l.image.url : '',
    lat: l.geometry.lat,
    lng: l.geometry.lng
  }))) %>;
</script>
<% } %>


<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display != "inline"){
                info.style.display = "inline";
            }else{
                info.style.display = "none";
            }
        }
    });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const activeCategory = document.querySelector("#filters .filter-link.active");
    if (activeCategory) {
      activeCategory.scrollIntoView({
        behavior: "smooth",
        inline: "center",
        block: "nearest"
      });
    }
  });
</script>